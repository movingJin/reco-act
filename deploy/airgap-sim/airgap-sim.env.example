# airgap 모의 환경(public 서버)의 설정 파일. 비밀이 들어간다. 레포에 커밋하지 않는다.
# GitHub 저장소 Secrets의 AIRGAP_SIM_ENV에 이 파일 전체를 base64로 넣으면 Actions가 서버에 airgap-sim.env로 써 준다.
#   base64 -w0 airgap-sim.env   (macOS: base64 -i airgap-sim.env)
# 같은 파일을 컨테이너 env_file과 compose 변수(--env-file)로 함께 쓴다.

# ---- DB(모의 환경 전용 PostgreSQL 컨테이너. public 운영 DB와 따로) ----
POSTGRES_USER=reco_act
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=reco_act
DATABASE_URL=postgresql://reco_act:CHANGE_ME@db:5432/reco_act

# ---- 앱 비밀 ----
# JWT 서명 키. openssl rand -hex 32 로 만든다(public 운영과 다른 값).
SECRET_KEY=CHANGE_ME
# OpenRouter API 키. 모의 환경의 요약·용어 보정이 쓴다.
LLM_API_KEY=CHANGE_ME

# ---- 메일: public과 같은 Gmail(2026-10-24 결정) ----
# 가입 인증코드·비밀번호 재설정·회의록 메일을 보낸다. 실제 airgap은 설치할 때 사내 메일 서버 값으로 바꾼다(01-plan 3.9).
# SENDER_PASSWORD는 Gmail 앱 비밀번호다. 비워 두면 메일 기능이 실패한다.
SMTP_HOST=smtp.gmail.com
SMTP_SECURITY=ssl
SMTP_PORT=465
SENDER_EMAIL=CHANGE_ME@gmail.com
SENDER_PASSWORD=CHANGE_ME

# ---- compose 변수(선택, 기본값) ----
# SIM_WEB_PORT=23002
# SIM_WHISPER_MODEL_DIR=faster-whisper-small
# SIM_PYANNOTE_PIPELINE_DIR=speaker-diarization-community-1
# SIM_WORKER_CPUS=4
# SIM_WORKER_MEMORY=8g
# SIM_LLM_MODEL=qwen/qwen3-32b
# SIM_LLM_MAX_TOKENS=8192
# 선택(앱 기본값): SUMMARY_AUTO=true, TERM_CORRECTION_LLM=false, SUMMARY_CHUNK_CHARS=12000
