# api·worker의 env_file. 비밀이 들어가므로 현장 서버의 /opt/reco-act/airgap.env에 두고 권한을 600으로 한다.
# 이미지와 반입 번들에는 넣지 않는다. 프로파일·오프라인·LLM 접속 설정은 docker-compose.airgap.yaml에 고정돼 있다.

# DB(db.env의 값과 맞춘다)와 Redis(compose 안의 서비스)
DATABASE_URL=postgresql://reco_act:CHANGE_ME@db:5432/reco_act
REDIS_HOST=redis
REDIS_PORT=6379
# JWT 서명 키. openssl rand -hex 32 로 만든다.
SECRET_KEY=CHANGE_ME

# 사내 메일 서버(발주처에서 받는다, 01-plan 3.9). 비워 두면 가입 인증코드·비밀번호 재설정·회의록 메일이 실패한다.
SMTP_HOST=
SMTP_SECURITY=starttls
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# 내부 도메인(쉼표로 구분, 예: agency.go.kr). 메일 서버가 FQDN이면 넣어야 기동 검사를 통과한다.
AIRGAP_INTERNAL_DOMAINS=

# 선택(기본값): SUMMARY_AUTO=true, TERM_CORRECTION_LLM=false, SUMMARY_CHUNK_CHARS=12000, SUMMARY_WAIT_TIMEOUT=1500
