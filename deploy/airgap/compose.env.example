# docker compose --env-file로 넘기는 값(비밀 아님). 현장에서는 /opt/reco-act/compose.env로 복사해 고친다.
RECO_ACT_VERSION=2026.10.24
# 서버 디스크의 데이터 위치. 아래에 airgap.env, db.env, tls/, models/, records/, pgdata/, redis/가 있어야 한다(백업은 NAS).
RECO_ACT_HOME=/opt/reco-act
WEB_HTTPS_PORT=443
WEB_HTTP_PORT=80

# 모델 디렉터리 이름(RECO_ACT_HOME/models 아래). 반입 번들의 manifest와 맞춘다.
WHISPER_MODEL_DIR=faster-whisper-large-v3
PYANNOTE_PIPELINE_DIR=speaker-diarization-community-1
LLM_MODEL_DIR=Qwen3-32B-AWQ

# vLLM. 메모리·컨텍스트 값은 GPU 환경에서 실측해 정한다(01-plan 3.6). 컨텍스트는 요약 청크(SUMMARY_CHUNK_CHARS) + 지시문 + 출력보다 커야 한다.
VLLM_VERSION=v0.31.0
VLLM_SERVED_MODEL_NAME=qwen3-32b
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.70
